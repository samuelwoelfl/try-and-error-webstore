# Deny access to dotfiles (defense in depth — .env itself is not deployed inside
# this folder, but this blocks stray .env/.git/etc. if ever misplaced here).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# No directory listings.
Options -Indexes

AddDefaultCharset utf-8

# Serve the dynamically generated sitemap at the conventional /sitemap.xml URL.
RewriteEngine On
RewriteRule ^sitemap\.xml$ sitemap.php [L]
