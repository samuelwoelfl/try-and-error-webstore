# App
APP_ENV=production
# Optional — nur setzen, falls die automatische Erkennung (aus dem Request-Host)
# nicht passt. Wird für den "Bestellung ansehen"-Link in Bestell-E-Mails gebraucht.
SITE_URL=https://deine-domain.de

# MySQL/MariaDB (bei Strato: Kundenlogin → Datenbanken → Datenbank anlegen,
# du bekommst Host, Datenbankname, Benutzer und Passwort automatisch generiert)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Admin-Login (wird nur beim allerersten Aufruf in die admin_users-Tabelle geseedet —
# zum Ändern später: Zeile in admin_users löschen und .installed-Datei entfernen)
ADMIN_EMAIL=admin@atelier.de
ADMIN_PASSWORD=change-me-now

# Stripe (Kredit-/Debitkarte, Apple Pay, Google Pay via Payment Element)
# Test-Keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing-Secret aus dem Stripe-Dashboard (Webhook-Endpoint: /api/webhooks/stripe.php)
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal (Orders v2 REST API)
# https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Rechnung / Überweisung — Bankdaten, die dem Kunden per E-Mail geschickt werden
BANK_HOLDER=Atelier Stuttgart
BANK_IBAN=DE00 0000 0000 0000 0000 00
BANK_BIC=XXXXXXXX

# E-Mail (Bestellbestätigung, Rechnung, Kontaktformular)
# MAIL_ENABLED=false schreibt E-Mails nur ins PHP-Error-Log statt sie zu versenden (Debugging).
MAIL_ENABLED=true
MAIL_FROM=Atelier Stuttgart <no-reply@deine-domain.de>
CONTACT_EMAIL=
