# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string

# Admin login (seeded into the admin_users table on first boot only —
# to rotate the password afterwards, delete the row in admin_users and restart)
ADMIN_EMAIL=admin@atelier.de
ADMIN_PASSWORD=change-me-now

# Stripe (Kredit-/Debitkarte, Apple Pay, Google Pay via Payment Element)
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (local dev)
# or the webhook's signing secret in the Stripe Dashboard (production).
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal (Orders v2 REST API — Sandbox app credentials for testing)
# https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Rechnung / Überweisung — bank details sent to the customer by email
BANK_HOLDER=Atelier Stuttgart
BANK_IBAN=DE00 0000 0000 0000 0000 00
BANK_BIC=XXXXXXXX

# SMTP (order confirmations, invoice emails, contact form) — optional in dev;
# without it, emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Atelier Stuttgart <no-reply@example.com>
CONTACT_EMAIL=
